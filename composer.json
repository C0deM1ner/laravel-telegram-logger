{
    "name": "c0dem1ner/laravel-telegram-logger",
    "description": "Telegram Log integration for Laravel",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "c0dem1ner",
            "email": "noro.danielyan.1998@gmail.com",
            "homepage": "https://github.com/C0deM1ner"
        }
    ],
    "require": {
        "php": ">=7.4",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "C0deM1ner\\LaravelTelegramLogger\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "C0deM1ner\\LaravelTelegramLogger\\Providers\\TelegramLoggerServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^1.0|^2.0|^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "C0deM1ner\\LaravelTelegramLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "lint": "pint --test"
    }
}
